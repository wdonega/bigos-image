# URL do ComfyUI (nunca exposta ao navegador)
COMFY_URL=http://localhost:8188

# Redis da fila de geração (docker compose up -d redis)
REDIS_URL=redis://127.0.0.1:6379

# Pasta dos arquivos gerados e enviados (relativa à raiz do projeto)
STORAGE_DIR=storage

# Limites de imagem (spec §5, §6 e §7)
MAX_REFS=10
# 2048 x 2048, pixels totais da saída
MAX_PIXELS=4194304
MIN_SIDE=512
# lado maior dividido pelo menor, no máximo (Manual)
MAX_ASPECT_RATIO=4
# imagens de entrada maiores são reduzidas no backend
MAX_INPUT_PIXELS=4194304
MAX_UPLOAD_MB=20

# Retenção de arquivos temporários (uploads e resultados)
RETENTION_HOURS=24

# Tempo máximo de uma geração antes de ser cancelada
JOB_TIMEOUT_MINUTES=15

# Qualidade = passos de amostragem (spec §8.1)
STEPS_NORMAL=25
STEPS_HIGH=40
