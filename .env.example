# ComfyUI URL (never exposed to the browser)
COMFY_URL=http://localhost:8188

# Redis for the generation queue (docker compose up -d redis)
REDIS_URL=redis://127.0.0.1:6379

# Folder for generated and uploaded files (relative to the project root)
STORAGE_DIR=storage

# Image limits (spec §5, §6 and §7)
MAX_REFS=10
# 2048 x 2048, total output pixels
MAX_PIXELS=4194304
MIN_SIDE=512
# longest side divided by the shortest, at most (Manual)
MAX_ASPECT_RATIO=4
# larger input images are reduced by the backend
MAX_INPUT_PIXELS=4194304
# sum of the pixels of all images in one job (10 x 1 MP); above it references are reduced
MAX_REFS_TOTAL_PIXELS=10485760
MAX_UPLOAD_MB=20

# Retention of temporary files (uploads and results)
RETENTION_HOURS=24

# Maximum time for one generation before it is cancelled
JOB_TIMEOUT_MINUTES=15

# Quality = sampling steps (spec §8.1)
STEPS_NORMAL=25
STEPS_HIGH=40
