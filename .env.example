# Only COMFY_URL and REDIS_URL are required; every other value below is the default
# (src/lib/config.ts) and can be left out. Docker: see docker-compose.yml.

# ComfyUI URL (never exposed to the browser)
COMFY_URL=http://localhost:8188
# The ComfyUI machine may sleep and wake on LAN (~10 s): seconds to wait before "unavailable"
COMFY_WAKE_SECONDS=30

# Redis for the generation queue (docker compose up -d redis)
REDIS_URL=redis://127.0.0.1:6379

# Folder for generated and uploaded files (relative to the project root)
STORAGE_DIR=storage

# Image limits (spec §5, §6 and §7)
MAX_REFS=10
# 2048 x 2048, total output pixels
MAX_PIXELS=4194304
MIN_SIDE=512
# longest side divided by the shortest, at most (Manual)
MAX_ASPECT_RATIO=4
# larger input images are reduced by the backend
MAX_INPUT_PIXELS=4194304
# sum of the pixels of all images in one job (10 x 1 MP); above it references are reduced
MAX_REFS_TOTAL_PIXELS=10485760
MAX_UPLOAD_MB=20

# Retention of temporary files (uploads and results)
RETENTION_HOURS=24

# Maximum time for one generation before it is cancelled
JOB_TIMEOUT_MINUTES=15

# Quality = sampling steps (spec §8.1)
STEPS_NORMAL=25
STEPS_HIGH=40

# Video (MiniMax H3): output pixels per Quality (≈720p / ≈1080p at 16:9), max reference
# images (the ComfyUI node takes 9) and the time limit of one video generation
VIDEO_PIXELS_NORMAL=921600
VIDEO_PIXELS_HIGH=2073600
MAX_VIDEO_REFS=9
VIDEO_JOB_TIMEOUT_MINUTES=40

# Optional "Improve text" (OpenAI-compatible API, e.g. LiteLLM). Leave LLM_URL empty to hide it.
# The key goes only in .env, never in git.
LLM_URL=
LLM_API_KEY=
LLM_MODEL=prompt-enhancer
# Match the model's limits in LiteLLM (max_output_tokens; max_input_tokens ≈ 4096 fits 4000 chars)
LLM_MAX_OUTPUT_TOKENS=800
LLM_MAX_INPUT_CHARS=4000
