# URL do ComfyUI (nunca exposta ao navegador)
COMFY_URL=http://localhost:8188

# Limites de imagem (spec §5, §6 e §7)
MAX_REFS=10
MAX_PIXELS=4194304          # 2048 x 2048, pixels totais da saída
MIN_SIDE=512
MAX_INPUT_PIXELS=4194304    # imagens de entrada maiores são reduzidas no backend
MAX_UPLOAD_MB=20

# Retenção de arquivos temporários (uploads e resultados)
RETENTION_HOURS=24

# Qualidade = passos de amostragem (spec §8.1)
STEPS_NORMAL=25
STEPS_HIGH=40
